<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OsuPP</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    
  </ItemGroup>

  <ItemGroup>
    <!-- Match the version used by ppy/osu-queue-score-statistics. -->
    <PackageReference Include="ppy.osu.Game" Version="2026.1026.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Catch" Version="2026.1026.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Mania" Version="2026.1026.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Osu" Version="2026.1026.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Taiko" Version="2026.1026.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
